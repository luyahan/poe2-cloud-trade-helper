{
  "name": "poe2-trade-tray",
  "version": "0.1.0",
  "private": true,
  "description": "PoE2 云游戏查价托盘助手：热键旁听 Ctrl+Alt+C → 解析装备 → 匹配国服词典 → 打开市集",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "check": "node --check src/main.js && node --check src/hotkey.js && node --check src/clipboard.js && node --check src/query.js && node --check src/settings.js && node --check src/lib/parse-item.js && node --check src/lib/weapon-dps.js && node --check src/lib/match-stats.js && node --check scripts/prepare-data.js",
    "prepare-data": "node scripts/prepare-data.js",
    "predist": "npm run check && npm test && npm run prepare-data",
    "dist": "electron-builder --mac dir --arm64 && node scripts/sign-app.js",
    "pack": "electron-builder --mac dir"
  },
  "author": "local",
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "uiohook-napi": "^1.5.5"
  },
  "build": {
    "appId": "com.local.poe2-trade-tray",
    "productName": "PoE2查价助手",
    "npmRebuild": false,
    "asar": true,
    "asarUnpack": [
      "node_modules/uiohook-napi/**"
    ],
    "files": [
      "src/**",
      "assets/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build-data",
        "to": "build-data",
        "filter": ["cn-stats.json", "build-meta.json"]
      }
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        { "target": "dmg", "arch": ["arm64", "x64"] }
      ],
      "icon": "assets/icon.icns",
      "identity": null,
      "extendInfo": {
        "LSUIElement": true,
        "NSAppleEventsUsageDescription": "PoE2 查价助手需要监听全局热键以在游戏内复制装备后自动查价。"
      }
    },
    "dmg": {
      "title": "PoE2 查价助手 ${version}",
      "contents": [
        { "x": 130, "y": 220 },
        { "x": 410, "y": 220, "type": "link", "path": "/Applications" }
      ]
    }
  }
}